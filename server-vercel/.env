# Use a serverless-friendly Postgres provider (Neon, Supabase, or Vercel Postgres)
# and its POOLED connection string, since serverless functions open many
# short-lived connections.
DATABASE_URL=postgresql://user:password@host/login_app?sslmode=require

JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Your deployed frontend URL (Vercel project URL or custom domain)
CLIENT_ORIGIN=https://login-4dbpp7z3r-a-f280.vercel.app
