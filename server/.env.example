# Postgres (pooled connection string from Neon/Supabase/Vercel Postgres)
DATABASE_URL=postgresql://user:password@host/login_app?sslmode=require

JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Must exactly match your deployed frontend URL, no trailing slash
CLIENT_ORIGIN=https://login-sooty-rho.vercel.app

# Firebase Admin — paste the ENTIRE service account JSON as one line
# (Firebase Console > Project Settings > Service Accounts > Generate new private key)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}

# SMTP for sending password-reset emails (e.g. Gmail app password, Resend, Mailgun, SES)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-smtp-password
SMTP_FROM=your@email.com
